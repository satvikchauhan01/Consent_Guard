# ==========================================
# ConsentGuard Environment Configuration
# ==========================================

# Server & Runtime
NODE_ENV=development
PORT=4000

# Database
MONGO_URI=mongodb://localhost:27017/consentguard

# Security & Tokens (Minimum 32 characters for production)
JWT_SECRET=consentguard_jwt_super_secret_signing_key_min_32_chars!
SESSION_COOKIE_SECRET=consentguard_session_cookie_secret_key_min_32_chars!
HMAC_KEY=consentguard_hmac_sha256_hashing_key_for_api_tokens_32c!

# Rate Limiting (Thresholds and Window in Milliseconds)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000

RATE_LIMIT_CHECK_MAX=1000
RATE_LIMIT_CHECK_WINDOW_MS=60000

RATE_LIMIT_ADMIN_MAX=100
RATE_LIMIT_ADMIN_WINDOW_MS=60000

# Cache & Consent Policy Rules
CACHE_TTL_SECONDS=30
RECONSENT_GRACE_HOURS=24

# AI Compliance Layer (Explicitly Optional)
# ANTHROPIC_API_KEY=sk-ant-...
